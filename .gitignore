# Python
__pycache__/
*.pyc
.venv/
.venv_test/
*.egg-info/
.pytest_cache/

# Node
node_modules/
frontend/dist/

# Env / secrets
.env
.env.local

# Local Docker override — real CREDENTIAL_ENCRYPTION_KEY/SECRET_KEY and a
# bind-mount to this machine's dev.db. Machine-specific, never committed.
docker-compose.override.yml

# Local dev database (SQLite) — contains real encrypted camera credentials
# and real alert/incident records once the app has actually run
*.db
*.db-journal

# Models (large binaries — document how to obtain them instead of committing)
models/*.pt
models/*.onnx
models/*.engine

# Runtime data
storage/clips/*
storage/snapshots/*
!storage/clips/.gitkeep
!storage/snapshots/.gitkeep

# Training data for a custom AGE_MODEL — real photos of real children and
# staff extracted from actual classroom footage. Must never be committed.
# (scripts/extract_crops.py runs from backend/ but writes one level up via
# ../training_data, so this lands at the repo root, not backend/.)
/training_data/

# Same reasoning for the ml_pipeline dataset (1_collect_features.py's crops
# and features.csv, and the trained model) — real classroom photos, never
# committed. Move this between machines via a direct transfer, not git.
ml_pipeline/data/
ml_pipeline/*.pt

# Misc
.DS_Store
*.log
backend/.backups/
