# ── Welmont Lalkothi seed script (scripts/seed_welmont.py) ──
# Only needed if you run `python -m scripts.seed_welmont` — real credentials
# for that specific deployment's cameras, provided by the site owner.
WELMONT_RTSP_HOST=
WELMONT_RTSP_USERNAME=
WELMONT_RTSP_PASSWORD=
WELMONT_RTSP_PATH=/Streaming/Channels/101

# ── Database ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=classroom_monitor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/classroom_monitor

# ── Redis (event bus fan-out / multi-worker deployments) ────
REDIS_URL=redis://localhost:6379/0

# ── Secrets ───────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-value
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key-see-README

# ── CV models (paths are relative to /models, mounted volume) ──
PERSON_MODEL=models/yolov8n.pt
AGE_MODEL=
POSE_MODEL=models/yolov8n-pose.pt
DEVICE=auto
# comma separated list of COCO class ids to keep (0 = person)
DETECTOR_CLASSES=0
DETECTOR_CONF_THRESHOLD=0.4
DETECTOR_IOU_THRESHOLD=0.45

# ── Inference pipeline pacing ─────────────────────────────
INFERENCE_FPS=12
CLASSIFICATION_EVERY_N_DETECT=3
# Must comfortably exceed how long CLASSIFICATION_WINDOW takes to fill:
# at these settings, classification runs ~4x/sec per track (INFERENCE_FPS /
# CLASSIFICATION_EVERY_N_DETECT), so a window of 15 needs ~3.75s of
# continuous tracking. If this timeout is shorter than that, a busy/occluded
# scene keeps dropping tracks (and their accumulated history) before
# classification ever has enough continuous data to reach a confident
# ADULT/CHILD label — confirmed 2026-09-08 against real Welmont footage.
TRACK_TIMEOUT_SECONDS=5.0

# ── Classification ────────────────────────────────────────
CLASSIFICATION_WINDOW=15
ADULT_CONFIDENCE_THRESHOLD=0.75
CHILD_CONFIDENCE_THRESHOLD=0.75

# ── Supervision state machine ─────────────────────────────
UNSUPERVISED_DELAY_SECONDS=10
ADULT_GRACE_PERIOD_SECONDS=3
CAMERA_OFFLINE_TIMEOUT_SECONDS=5
# Assumed average adult height (cm) — used only to convert a calibration
# height ratio into a display centimeter estimate, not a precision value.
REFERENCE_ADULT_HEIGHT_CM=165

# ── Video buffer / clips ──────────────────────────────────
VIDEO_BUFFER_SECONDS=10
VIDEO_RETENTION_DAYS=7
CLIP_STORAGE_DIR=./storage/clips

# ── Hardware / buzzer ──────────────────────────────────────
ALERT_OUTPUT_DRIVER=mock
# for network_relay / esp32
RELAY_BASE_URL=http://192.168.1.50
RELAY_TIMEOUT_SECONDS=2
RELAY_MAX_RETRIES=3

# ── Misc ───────────────────────────────────────────────────
DEBUG_MODE=false
CORS_ORIGINS=http://localhost:5173
